ILMB_DRIVE_FOLDER_ID=
ILMB_GOOGLE_KEY_FILE=/etc/ilmb-sync/google-service-account.json
ILMB_DB_HOST=
ILMB_DB_PORT=3306
ILMB_DB_NAME=
ILMB_DB_USER=
ILMB_DB_PASSWORD=
ILMB_MODULE_CONFIG=/opt/ilmb-sync/config/modules.json
ILMB_WORK_DIR=/var/lib/ilmb-sync
ILMB_LOG_LEVEL=INFO
ILMB_REQUIRE_APPROVAL=true
ILMB_MAX_FILE_MB=100
ILMB_ALLOWED_EXTENSIONS=.xlsx,.xlsm
